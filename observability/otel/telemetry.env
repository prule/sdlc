# Enable Claude Code OpenTelemetry export to the local stack.
# Use it for a session:   set -a && source observability/otel/telemetry.env && set +a && claude
# (or `source` it in your shell before launching claude)
CLAUDE_CODE_ENABLE_TELEMETRY=1
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Faster feedback while comparing (defaults: metrics 60s, logs 5s):
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_LOGS_EXPORT_INTERVAL=5000
# Uncomment to include prompt text in event logs (off by default for privacy):
# OTEL_LOG_USER_PROMPTS=1
